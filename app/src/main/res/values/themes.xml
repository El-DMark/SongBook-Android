<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SongBook" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0F2027</item>

        <!-- Hide the native splash screen icon completely -->
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="windowSplashScreenAnimationDuration">0</item>

        <item name="postSplashScreenTheme">@style/Theme.SongBook</item>
    </style>
</resources>